#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Tautulli
# Runs the Home Assistant Ingress reverse proxy
# ==============================================================================
bashio::net.wait_for 8182 localhost 300
bashio::log.info "Starting Ingress proxy..."
mkdir -p /var/log/nginx
exec nginx -c /run/tautulli-nginx.conf -g "daemon off;"
