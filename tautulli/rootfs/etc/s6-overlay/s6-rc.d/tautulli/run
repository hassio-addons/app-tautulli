#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Tautulli
# Runs Tautulli
# ==============================================================================
bashio::log.info "Starting Tautulli..."
exec \
  python3 /opt/Tautulli.py \
    --datadir /data \
    --nolaunch \
    -p 8181
